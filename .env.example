# NEXDIAL — Environment Configuration Example

# Backend Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./nexdial.db
# Docker / Production PostgreSQL: postgresql+asyncpg://nexdial_user:nexdial_password@postgres:5432/nexdial_db
DATABASE_URL=sqlite+aiosqlite:///./nexdial.db
SYNC_DATABASE_URL=sqlite:///./nexdial.db

# Platform Settings
ENVIRONMENT=SIMULATION
PORT=8000
SECRET_KEY=nexdial_production_secret_key_change_me_987654321

# Safety & Pacing Engine Defaults
DEFAULT_SAFETY_BUFFER_RATIO=0.15
MAX_DIAL_RATIO_PREDICTIVE=2.5
DEFAULT_DIAL_RATIO=1.0

# Telecom Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=10.0
